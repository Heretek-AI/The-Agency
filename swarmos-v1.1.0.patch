new file mode 100644
index 0000000..de3a339
--- /dev/null
+++ b/src/epistemic/dialectic.ts
@@ -0,0 +1,258 @@
+import { createHash } from "node:crypto"
+import * as fs from "node:fs/promises"
+import * as path from "node:path"
+
+/**
+ * Pillar 1: IUMBTEMS Epistemic Sovereignty & Dialectic Engine (`src/epistemic/dialectic.ts`)
+ *
+ * Absorbs `@heretek-ai/epistemic-swarm` (IUMBTEMS) directly into SwarmOS:
+ * 1. Content-addressed SHA-256 raw source cache (`.opencode/epistemic/sources/<sha256>.md`).
+ * 2. Epistemic Tagging Taxonomy (`[VERIFIED: <hash>]`, `[INFERRED: <reasoning>]`,
+ *    `[HYPOTHESIS: <test>]`, `[NEGATIVE_KNOWLEDGE: <query>]`) with verbatim quote verification.
+ * 3. Socratic Assumption-Inversion Grill (`/grill` & `tools.epistemic.grill`).
+ * 4. Competitor Teardown & SPDX License Contamination Scout (`/darkharvest` & `tools.epistemic.audit_licenses`).
+ */
+
+export interface CachedEpistemicSource {
+  hash: string
+  shortHash: string
+  url: string
+  title: string
+  cachedAt: string
+  path: string
+  byteLength: number
+}
+
+export interface EpistemicVerificationReport {
+  verifiedClaims: Array<{ hash: string; quote?: string; valid: boolean; reason?: string }>
+  inferredClaims: string[]
+  hypothesisClaims: string[]
+  negativeKnowledgeClaims: string[]
+  untaggedParagraphs: number
+  integrityScore: number
+  passed: boolean
+}
+
+export interface LicenseAuditItem {
+  name: string
+  license: string
+  classification: "permissive" | "weak-copyleft" | "strong-copyleft" | "unknown"
+  verdict: "depend-or-vendor" | "dynamic-link-only" | "clean-room-rebuild-only" | "manual-review"
+}
+
+export function getEpistemicSourcesDir(rootDir: string): string {
+  return path.join(rootDir, ".opencode", "epistemic", "sources")
+}
+
+export async function cacheEpistemicSource(
+  rootDir: string,
+  input: { url: string; title: string; content: string },
+): Promise<CachedEpistemicSource> {
+  const fullHash = createHash("sha256").update(input.content, "utf8").digest("hex")
+  const shortHash = fullHash.slice(0, 12)
+  const dir = getEpistemicSourcesDir(rootDir)
+  await fs.mkdir(dir, { recursive: true })
+
+  const header = [
+    "---",
+    `hash: ${fullHash}`,
+    `shortHash: ${shortHash}`,
+    `url: ${input.url}`,
+    `title: ${input.title.replace(/\n/g, " ")}`,
+    `cachedAt: ${new Date().toISOString()}`,
+    "---",
+    "",
+  ].join("\n")
+
+  const filePath = path.join(dir, `${shortHash}.md`)
+  await fs.writeFile(filePath, `${header}${input.content}`, "utf8")
+
+  return {
+    hash: fullHash,
+    shortHash,
+    url: input.url,
+    title: input.title,
+    cachedAt: new Date().toISOString(),
+    path: filePath,
+    byteLength: Buffer.byteLength(input.content, "utf8"),
+  }
+}
+
+export async function verifyEpistemicClaims(
+  rootDir: string,
+  markdownText: string,
+): Promise<EpistemicVerificationReport> {
+  const dir = getEpistemicSourcesDir(rootDir)
+  let files: string[] = []
+  try {
+    files = await fs.readdir(dir)
+  } catch {
+    files = []
+  }
+
+  const sourceMap = new Map<string, string>()
+  for (const f of files) {
+    if (!f.endsWith(".md")) continue
+    const raw = await fs.readFile(path.join(dir, f), "utf8")
+    const stem = path.basename(f, ".md")
+    sourceMap.set(stem, raw)
+  }
+
+  const verifiedClaims: EpistemicVerificationReport["verifiedClaims"] = []
+  for (const m of markdownText.matchAll(/\[VERIFIED:\s*([a-f0-9]{6,64})(?:\s*\|\s*"([^"]+)")?\]/gi)) {
+    const hashPrefix = m[1].toLowerCase()
+    const quote = m[2]
+    const matchedKey = [...sourceMap.keys()].find((k) => k.startsWith(hashPrefix) || hashPrefix.startsWith(k))
+    if (!matchedKey) {
+      verifiedClaims.push({ hash: hashPrefix, quote, valid: false, reason: "Source hash not found in .opencode/epistemic/sources/" })
+      continue
+    }
+    const sourceBody = sourceMap.get(matchedKey)!
+    if (quote && !sourceBody.toLowerCase().includes(quote.toLowerCase().trim())) {
+      verifiedClaims.push({
+        hash: hashPrefix,
+        quote,
+        valid: false,
+        reason: `Verbatim quote "${quote.slice(0, 60)}" not found in cached source ${matchedKey}.md`,
+      })
+      continue
+    }
+    verifiedClaims.push({ hash: hashPrefix, quote, valid: true })
+  }
+
+  const inferredClaims = [...markdownText.matchAll(/\[INFERRED:\s*([^\]]+)\]/gi)].map((m) => m[1].trim())
+  const hypothesisClaims = [...markdownText.matchAll(/\[HYPOTHESIS:\s*([^\]]+)\]/gi)].map((m) => m[1].trim())
+  const negativeKnowledgeClaims = [...markdownText.matchAll(/\[NEGATIVE_KNOWLEDGE:\s*([^\]]+)\]/gi)].map((m) => m[1].trim())
+
+  const paragraphs = markdownText
+    .split(/\n\s*\n/)
+    .map((p) => p.trim())
+    .filter((p) => p.length > 60 && !p.startsWith("#") && !p.startsWith("|") && !p.startsWith("```"))
+
+  const untaggedParagraphs = paragraphs.filter(
+    (p) => !/\[(?:VERIFIED|INFERRED|HYPOTHESIS|NEGATIVE_KNOWLEDGE):/i.test(p),
+  ).length
+
+  const invalidCount = verifiedClaims.filter((c) => !c.valid).length
+  const totalTagged = verifiedClaims.length + inferredClaims.length + hypothesisClaims.length + negativeKnowledgeClaims.length
+  const baseScore = totalTagged > 0 ? 100 : 60
+  const integrityScore = Math.max(0, Math.min(100, baseScore - invalidCount * 25 - untaggedParagraphs * 5))
+
+  return {
+    verifiedClaims,
+    inferredClaims,
+    hypothesisClaims,
+    negativeKnowledgeClaims,
+    untaggedParagraphs,
+    integrityScore,
+    passed: invalidCount === 0 && integrityScore >= 75,
+  }
+}
+
+export function classifySpdxLicense(pkgName: string, spdx: string): LicenseAuditItem {
+  const norm = spdx.trim().toUpperCase()
+  if (/^(MIT|APACHE-2\.0|BSD-2-CLAUSE|BSD-3-CLAUSE|ISC|0BSD|UNLICENSE|ZLIB)$/.test(norm)) {
+    return { name: pkgName, license: spdx, classification: "permissive", verdict: "depend-or-vendor" }
+  }
+  if (/^(LGPL|MPL-2\.0|EPL)/.test(norm)) {
+    return { name: pkgName, license: spdx, classification: "weak-copyleft", verdict: "dynamic-link-only" }
+  }
+  if (/^(GPL|AGPL|SSPL|CC-BY-NC|CC-BY-SA)/.test(norm)) {
+    return { name: pkgName, license: spdx, classification: "strong-copyleft", verdict: "clean-room-rebuild-only" }
+  }
+  return { name: pkgName, license: spdx, classification: "unknown", verdict: "manual-review" }
+}
+
+export function generateSocraticGrillPrompt(objective: string): string {
+  return [
+    "# IUMBTEMS Socratic Grill & Assumption Inversion Protocol",
+    "",
+    `Target Objective: **${objective}**`,
+    "",
+    "Before writing any code or locking any contract, execute these 4 dialectic steps:",
+    "1. **Premise Inversion**: List the top 3 unstated assumptions in the objective and invert each one (what if the opposite is true?).",
+    "2. **Decision Tree Frontier**: Identify the 2–3 load-bearing architectural forks where choosing wrong forces a rewrite. Use `question` to ask the user with concrete tradeoffs.",
+    "3. **Thesis vs. Antithesis (Red-Team)**: State the strongest argument FOR the proposed design (Agent Alpha) and the sharpest failure mode that will break it in production (Agent Beta).",
+    "4. **Falsifiable Spike**: Define the smallest 1-command verification test that proves the core assumption works.",
+  ].join("\n")
+}
+
+export function registerEpistemicTools(editor: any, rootDir: string): void {
+  editor.namespace({
+    name: "epistemic",
+    description:
+      "IUMBTEMS Epistemic Sovereignty & Dialectic Research Engine: SHA-256 source caching, verbatim quote verification (`[VERIFIED: <hash>]`), Socratic grilling, and SPDX clean-room license auditing.",
+  })
+
+  editor.add({
+    name: "cache_source",
+    description:
+      "Store raw primary source text in the content-addressed SHA-256 epistemic cache (`.opencode/epistemic/sources/<shortHash>.md`) and return its verification hash.",
+    options: { namespace: "epistemic", codemode: true, pinned: false },
+    input: {
+      type: "object",
+      properties: {
+        url: { type: "string", description: "Source URL or document identifier" },
+        title: { type: "string", description: "Source title" },
+        content: { type: "string", description: "Raw markdown/text content of the source" },
+      },
+      required: ["url", "title", "content"],
+    },
+    output: { type: "object" },
+    execute: async (input: { url: string; title: string; content: string }) => {
+      const cached = await cacheEpistemicSource(rootDir, input)
+      return {
+        output: cached,
+        content: `Cached epistemic source [${cached.shortHash}] (${cached.byteLength} bytes) -> cite as [VERIFIED: ${cached.shortHash} | "exact quote"]`,
+      }
+    },
+  })
+
+  editor.add({
+    name: "verify_claims",
+    description:
+      "Audit a draft document's `[VERIFIED: <hash> | "quote"]`, `[INFERRED: ...]`, `[HYPOTHESIS: ...]`, and `[NEGATIVE_KNOWLEDGE: ...]` tags against `.opencode/epistemic/sources/`.",
+    options: { namespace: "epistemic", codemode: true, pinned: false },
+    input: {
+      type: "object",
+      properties: {
+        markdown: { type: "string", description: "Markdown text to verify" },
+      },
+      required: ["markdown"],
+    },
+    output: { type: "object" },
+    execute: async (input: { markdown: string }) => {
+      const report = await verifyEpistemicClaims(rootDir, input.markdown)
+      return { output: report, content: JSON.stringify(report, null, 2) }
+    },
+  })
+
+  editor.add({
+    name: "audit_licenses",
+    description:
+      "Classify candidate open-source packages by SPDX license (`permissive` -> vendor/depend vs. `strong-copyleft` GPL/AGPL -> clean-room spec rebuild only).",
+    options: { namespace: "epistemic", codemode: true, pinned: false },
+    input: {
+      type: "object",
+      properties: {
+        packages: {
+          type: "array",
+          items: {
+            type: "object",
+            properties: {
+              name: { type: "string" },
+              license: { type: "string" },
+            },
+            required: ["name", "license"],
+          },
+        },
+      },
+      required: ["packages"],
+    },
+    output: { type: "object" },
+    execute: async (input: { packages: Array<{ name: string; license: string }> }) => {
+      const items = (input.packages ?? []).map((p) => classifySpdxLicense(p.name, p.license))
+      return { output: { items }, content: JSON.stringify(items, null, 2) }
+    },
+  })
+}
