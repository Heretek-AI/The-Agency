+    viewport: { width: vw, height: vh },
+    horizontalOverflowPx,
+    elementOverflowCount,
+    collisionCount,
+    baselineJitterCount,
+    lowContrastCount,
+    descenderClipCount,
+    tinyTargetCount,
+    missingLabelCount,
+    uniqueFontSizes: fontSizes.size,
+    arbitraryInlineHexCount,
+    consoleErrorCount: 0,
+    failedNetworkCount: 0
+  };
