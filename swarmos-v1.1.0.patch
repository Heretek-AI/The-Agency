+import { execFile } from "node:child_process"
+import * as fs from "node:fs/promises"
+import * as path from "node:path"
+import { promisify } from "node:util"
+
+const execFileAsync = promisify(execFile)
+
+/**
+ * Pillar 4: On-Demand Domain Packs (`src/packs/index.ts`)
+ *
+ * Consolidates Heretek-AI's vertical plugins into one unified registry:
+ * - `re` (`opencode-rea`): Reverse Engineering & Binary Triage (`inspect_binary`, `strings_audit`).
+ * - `godot` (`godot-opencode`): Godot 4.x Engine `.tscn` scene tree parser & GDScript checker.
+ * - `gdevelop` (`GDevelop-Unlocked`): GDevelop 5 `game.json` inspector & `--heretek-debug-log` analyzer.
+ */
+
+export type DomainPackId = "re" | "godot" | "gdevelop"
+
+export interface DomainPackStatus {
+  id: DomainPackId
+  title: string
+  replacesRepo: string
+  active: boolean
+  autoDetected: boolean
+  reason: string
+}
+
+const activePacksByRoot = new Map<string, Set<DomainPackId>>()
+
+export async function detectDomainPacks(rootDir: string): Promise<DomainPackStatus[]> {
+  const key = path.resolve(rootDir)
+  const manual = activePacksByRoot.get(key) ?? new Set<DomainPackId>()
+
+  let hasGodot = false
+  let hasGDevelop = false
+  let hasBinary = false
+
+  try {
+    const entries = await fs.readdir(rootDir)
+    hasGodot = entries.includes("project.godot")
+    hasGDevelop = entries.includes("game.json") || entries.some((e) => e.endsWith(".gdg"))
+    hasBinary = entries.some((e) => /\.(?:exe|dll|so|dylib|bin|elf|apk|ipa)$/i.test(e))
+  } catch {
+    // ignore
+  }
+
+  if (hasGodot) manual.add("godot")
+  if (hasGDevelop) manual.add("gdevelop")
+  if (hasBinary) manual.add("re")
+  activePacksByRoot.set(key, manual)
+
+  return [
+    {
+      id: "re",
+      title: "Reverse Engineering & Binary Analysis Pack",
+      replacesRepo: "Heretek-AI/opencode-rea",
+      active: manual.has("re"),
+      autoDetected: hasBinary,
+      reason: hasBinary ? "Detected binary artifact in workspace" : manual.has("re") ? "Activated via /pack re" : "Dormant (0 token overhead)",
+    },
+    {
+      id: "godot",
+      title: "Godot 4.x Scene & GDScript Pack",
+      replacesRepo: "Heretek-AI/godot-opencode",
+      active: manual.has("godot"),
+      autoDetected: hasGodot,
+      reason: hasGodot ? "Detected project.godot" : manual.has("godot") ? "Activated via /pack godot" : "Dormant (0 token overhead)",
+    },
+    {
+      id: "gdevelop",
+      title: "GDevelop 5 Project & Debug Log Pack",
+      replacesRepo: "Heretek-AI/GDevelop-Unlocked",
+      active: manual.has("gdevelop"),
+      autoDetected: hasGDevelop,
+      reason: hasGDevelop ? "Detected GDevelop game.json/.gdg" : manual.has("gdevelop") ? "Activated via /pack gdevelop" : "Dormant (0 token overhead)",
+    },
+  ]
+}
+
+export function activateDomainPack(rootDir: string, packId: DomainPackId): void {
+  const key = path.resolve(rootDir)
+  const set = activePacksByRoot.get(key) ?? new Set<DomainPackId>()
+  set.add(packId)
+  activePacksByRoot.set(key, set)
+}
+
+export async function inspectGodotScene(rootDir: string, scenePath: string): Promise<{
+  path: string
+  formatVersion: number
+  extResources: Array<{ id: string; type: string; path: string }>
+  nodes: Array<{ name: string; type: string; parent: string; script?: string }>
+}> {
+  const abs = path.resolve(rootDir, scenePath)
+  const raw = await fs.readFile(abs, "utf8")
+  const headerMatch = /\[gd_scene[^\]]*format=(\d+)/.exec(raw)
+  const formatVersion = headerMatch ? Number(headerMatch[1]) : 3
+
+  const extResources: Array<{ id: string; type: string; path: string }> = []
+  for (const m of raw.matchAll(/\[ext_resource\s+([^\]]+)\]/g)) {
+    const attrs = m[1]
+    const id = /id="([^"]+)"/.exec(attrs)?.[1] ?? /id=(\S+)/.exec(attrs)?.[1] ?? ""
+    const type = /type="([^"]+)"/.exec(attrs)?.[1] ?? ""
+    const p = /path="([^"]+)"/.exec(attrs)?.[1] ?? ""
+    extResources.push({ id, type, path: p })
+  }
+
+  const nodes: Array<{ name: string; type: string; parent: string; script?: string }> = []
+  for (const m of raw.matchAll(/\[node\s+([^\]]+)\]([\s\S]*?)(?=\n\[|$)/g)) {
+    const attrs = m[1]
+    const body = m[2]
+    const name = /name="([^"]+)"/.exec(attrs)?.[1] ?? "Node"
+    const type = /type="([^"]+)"/.exec(attrs)?.[1] ?? "Node"
+    const parent = /parent="([^"]+)"/.exec(attrs)?.[1] ?? "."
+    const script = /script\s*=\s*ExtResource\(\s*"?([^")]+)"?\s*\)/.exec(body)?.[1]
+    nodes.push({ name, type, parent, ...(script ? { script } : {}) })
+  }
+
+  return { path: scenePath, formatVersion, extResources, nodes }
+}
+
+export async function inspectGDevelopProject(rootDir: string, projectPath: string = "game.json"): Promise<{
+  name: string
+  version: string
+  windowWidth: number
+  windowHeight: number
+  scenes: Array<{ name: string; objectsCount: number; eventsCount: number }>
+  globalObjectsCount: number
+  extensionsCount: number
+}> {
+  const abs = path.resolve(rootDir, projectPath)
+  const raw = JSON.parse(await fs.readFile(abs, "utf8"))
+  const props = raw.properties ?? {}
+  const layouts = Array.isArray(raw.layouts) ? raw.layouts : []
+
+  return {
+    name: props.name ?? "Untitled GDevelop Game",
+    version: props.version ?? "1.0.0",
+    windowWidth: Number(props.windowWidth ?? 800),
+    windowHeight: Number(props.windowHeight ?? 600),
+    scenes: layouts.map((l: any) => ({
+      name: String(l.name ?? "Scene"),
+      objectsCount: Array.isArray(l.objects) ? l.objects.length : 0,
+      eventsCount: Array.isArray(l.events) ? l.events.length : 0,
+    })),
+    globalObjectsCount: Array.isArray(raw.objects) ? raw.objects.length : 0,
+    extensionsCount: Array.isArray(raw.eventsFunctionsExtensions) ? raw.eventsFunctionsExtensions.length : 0,
+  }
+}
+
+export async function inspectBinaryTarget(rootDir: string, binaryPath: string): Promise<{
+  path: string
+  sizeBytes: number
+  format: "ELF" | "PE" | "Mach-O" | "WASM" | "Unknown"
+  extractedStringsSample: string[]
+}> {
+  const abs = path.resolve(rootDir, binaryPath)
+  const buf = await fs.readFile(abs)
+  let format: "ELF" | "PE" | "Mach-O" | "WASM" | "Unknown" = "Unknown"
+  if (buf.length >= 4) {
+    if (buf[0] === 0x7f && buf[1] === 0x45 && buf[2] === 0x4c && buf[3] === 0x46) format = "ELF"
+    else if (buf[0] === 0x4d && buf[1] === 0x5a) format = "PE"
+    else if (buf[0] === 0x00 && buf[1] === 0x61 && buf[2] === 0x73 && buf[3] === 0x6d) format = "WASM"
+    else if (
+      (buf[0] === 0xfe && buf[1] === 0xed && buf[2] === 0xfa && (buf[3] === 0xce || buf[3] === 0xcf)) ||
+      (buf[3] === 0xfe && buf[2] === 0xed && buf[1] === 0xfa && (buf[0] === 0xce || buf[0] === 0xcf))
+    ) {
+      format = "Mach-O"
+    }
+  }
+
+  // Extract printable ASCII strings >= 5 chars directly from buffer (zero external bin dependency required)
+  const strings: string[] = []
+  let current = ""
+  for (let i = 0; i < Math.min(buf.length, 512 * 1024); i++) {
+    const b = buf[i]
+    if (b >= 32 && b <= 126) {
+      current += String.fromCharCode(b)
+    } else {
+      if (current.length >= 5 && /[A-Za-z]/.test(current)) {
+        strings.push(current)
+        if (strings.length >= 60) break
+      }
+      current = ""
+    }
+  }
+  if (current.length >= 5 && strings.length < 60) strings.push(current)
+
+  return {
+    path: binaryPath,
+    sizeBytes: buf.length,
+    format,
+    extractedStringsSample: strings,
+  }
+}
