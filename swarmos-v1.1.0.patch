+var PERMISSIVE_LICENSES = new Set(["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "0BSD", "Unlicense", "CC0-1.0"]);
+var WEAK_COPYLEFT_LICENSES = new Set(["MPL-2.0", "LGPL-2.1", "LGPL-2.1-only", "LGPL-3.0", "LGPL-3.0-only", "EPL-2.0"]);
+var STRONG_COPYLEFT_LICENSES = new Set(["GPL-2.0", "GPL-2.0-only", "GPL-3.0", "GPL-3.0-only", "AGPL-3.0", "AGPL-3.0-only", "SSPL-1.0"]);
