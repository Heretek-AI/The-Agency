+import * as fs from "node:fs/promises"
+import * as path from "node:path"
+
+/**
+ * Pillar 3: Quantitative 100-Point Visual Quality & UI/UX Judge (`src/omni/ux-judge.ts`)
+ *
+ * Evaluates live DOM geometry, typography, color contrast, spacing rhythm, alignment cohesion,
+ * and interactive affordances on a deterministic 0–100 scale (`grade: "S" | "A" | "B" | "C" | "F"`).
+ * UI tasks require `score >= 85` (`passed: true`) before sign-off.
+ */
+
+export interface UXRawMetrics {
+  viewport: { width: number; height: number }
+  horizontalOverflowPx: number
+  elementOverflowCount: number
+  siblingCollisionCount: number
+  baselineJitterCount: number
+  lowContrastCount: number
+  descenderClipCount: number
+  tinyTargetCount: number
+  unlabeledControlCount: number
+  offGridSpacingCount: number
+  totalSpacingSamples: number
+  distinctFontSizes: number
+  headingToBodyRatio: number
+  proseLineLengthViolations: number
+  neonSlopGradientCount: number
+  viewportCoverageRatio: number
+}
+
+export interface UXAxisScore {
+  axis: string
+  score: number
+  maxScore: number
+  notes: string[]
+}
+
+export interface UXScorecard {
+  score: number
+  grade: "S" | "A" | "B" | "C" | "F"
+  passed: boolean
+  threshold: number
+  axes: UXAxisScore[]
+  remediations: string[]
+  evaluatedAt: string
+}
+
+export const UX_SCORECARD_BROWSER_SCRIPT = `(() => {
+  const vw = window.innerWidth || 1440;
+  const vh = window.innerHeight || 900;
+  const horizontalOverflowPx = Math.max(0, document.documentElement.scrollWidth - vw - 2);
+
+  let elementOverflowCount = 0;
+  let siblingCollisionCount = 0;
+  let baselineJitterCount = 0;
+  let lowContrastCount = 0;
+  let descenderClipCount = 0;
+  let tinyTargetCount = 0;
+  let unlabeledControlCount = 0;
+  let offGridSpacingCount = 0;
+  let totalSpacingSamples = 0;
+  let proseLineLengthViolations = 0;
+  let neonSlopGradientCount = 0;
+  let occupiedArea = 0;
+
+  const fontSizes = new Set();
+  let maxHeadingSize = 16;
+  let bodyFontSize = parseFloat(getComputedStyle(document.body).fontSize) || 16;
+
+  function parseRgb(str) {
+    const m = str && str.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
+    if (!m) return null;
+    return { r: +m[1], g: +m[2], b: +m[3], a: m[4] !== undefined ? +m[4] : 1 };
+  }
+  function luminance({ r, g, b }) {
+    const a = [r, g, b].map((v) => {
+      v /= 255;
+      return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+    });
+    return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
+  }
+  function contrastRatio(c1, c2) {
+    const l1 = luminance(c1);
+    const l2 = luminance(c2);
+    return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
+  }
+  function effectiveBg(el) {
+    let cur = el;
+    while (cur && cur.nodeType === 1) {
+      const bg = parseRgb(getComputedStyle(cur).backgroundColor);
+      if (bg && bg.a >= 0.85) return bg;
+      cur = cur.parentElement;
+    }
+    return { r: 255, g: 255, b: 255, a: 1 };
+  }
+
+  const all = Array.from(document.querySelectorAll('body *'));
+  for (const el of all) {
+    const style = getComputedStyle(el);
+    if (style.display === 'none' || style.visibility === 'hidden' || +style.opacity === 0) continue;
+    const rect = el.getBoundingClientRect();
+    if (rect.width === 0 && rect.height === 0) continue;
+
+    if (el.parentElement === document.body) {
+      occupiedArea += Math.min(rect.width, vw) * Math.min(rect.height, vh);
+    }
+
+    const fs = Math.round(parseFloat(style.fontSize) || 16);
+    fontSizes.add(fs);
+    if (/^H[1-3]$/.test(el.tagName)) maxHeadingSize = Math.max(maxHeadingSize, fs);
+
+    if (style.backgroundImage && /linear-gradient|radial-gradient/i.test(style.backgroundImage)) {
+      if (/rgba?\(\s*(?:1[2-9]\d|2[0-5]\d)\s*,\s*[0-6]\d\s*,\s*2[0-5]\d/i.test(style.backgroundImage)) {
+        neonSlopGradientCount++;
+      }
+    }
+
+    for (const prop of ['paddingTop', 'paddingBottom', 'paddingLeft', 'paddingRight', 'gap']) {
+      const val = Math.round(parseFloat(style[prop]) || 0);
+      if (val > 0) {
+        totalSpacingSamples++;
+        if (val % 4 !== 0 && val % 6 !== 0) offGridSpacingCount++;
+      }
+    }
+
+    if (
+      el.scrollWidth > el.clientWidth + 2 &&
+      style.overflowX !== 'auto' &&
+      style.overflowX !== 'scroll' &&
+      style.overflowX !== 'hidden'
+    ) {
+      elementOverflowCount++;
+    }
+
+    const isInteractive = el.matches('button, a, input, select, textarea, [role="button"]');
+    if (isInteractive) {
+      if (rect.width < 24 || rect.height < 24) tinyTargetCount++;
+      const label = (el.textContent || '') + (el.getAttribute('aria-label') || '') + (el.getAttribute('title') || '') + (el.getAttribute('placeholder') || '');
+      if (!label.trim() && !el.querySelector('svg, img')) unlabeledControlCount++;
+    }
+
+    const hasDirectText = Array.from(el.childNodes).some((n) => n.nodeType === 3 && n.textContent.trim().length > 0);
+    if (hasDirectText) {
+      const fg = parseRgb(style.color);
+      const bg = effectiveBg(el);
+      if (fg && bg) {
+        const ratio = contrastRatio(fg, bg);
+        const minR = fs >= 19 ? 3.0 : 4.5;
+        if (ratio < minR) lowContrastCount++;
+      }
+      const lh = parseFloat(style.lineHeight);
+      if (lh && fs && lh / fs < 1.15 && style.overflow === 'hidden') descenderClipCount++;
+      if (el.tagName === 'P' && (el.textContent || '').trim().length > 140 && rect.width > fs * 52) {
+        proseLineLengthViolations++;
+      }
+    }
+
+    const children = Array.from(el.children).filter((c) => {
+      const cs = getComputedStyle(c);
+      return cs.display !== 'none' && cs.visibility !== 'hidden' && cs.position !== 'absolute' && cs.position !== 'fixed';
+    });
+    for (let i = 0; i < children.length; i++) {
+      const r1 = children[i].getBoundingClientRect();
+      for (let j = i + 1; j < children.length; j++) {
+        const r2 = children[j].getBoundingClientRect();
+        const overlapX = Math.max(0, Math.min(r1.right, r2.right) - Math.max(r1.left, r2.left));
+        const overlapY = Math.max(0, Math.min(r1.bottom, r2.bottom) - Math.max(r1.top, r2.top));
+        if (overlapX > 2 && overlapY > 2) siblingCollisionCount++;
+        const topDiff = Math.abs(r1.top - r2.top);
+        if (topDiff > 0.5 && topDiff <= 3.5 && overlapX === 0) baselineJitterCount++;
+      }
+    }
+  }
+
+  return {
+    viewport: { width: vw, height: vh },
+    horizontalOverflowPx,
+    elementOverflowCount,
+    siblingCollisionCount,
+    baselineJitterCount,
+    lowContrastCount,
+    descenderClipCount,
+    tinyTargetCount,
+    unlabeledControlCount,
+    offGridSpacingCount,
+    totalSpacingSamples,
+    distinctFontSizes: fontSizes.size,
+    headingToBodyRatio: +(maxHeadingSize / Math.max(12, bodyFontSize)).toFixed(2),
+    proseLineLengthViolations,
+    neonSlopGradientCount,
+    viewportCoverageRatio: +Math.min(1, occupiedArea / Math.max(1, vw * vh)).toFixed(2)
+  };
+})()`
+
+export function scoreUXMetrics(m: UXRawMetrics, threshold: number = 85): UXScorecard {
+  const axes: UXAxisScore[] = []
+  const remediations: string[] = []
+
+  // Axis 1: Spatial Rhythm & Whitespace Balance (20 pts)
+  let spatial = 20
+  const spatialNotes: string[] = []
+  const offGridRatio = m.totalSpacingSamples > 0 ? m.offGridSpacingCount / m.totalSpacingSamples : 0
+  if (offGridRatio > 0.25) {
+    const penalty = Math.min(10, Math.round(offGridRatio * 20))
+    spatial -= penalty
+    spatialNotes.push(`${m.offGridSpacingCount}/${m.totalSpacingSamples} spacing values off 4px/6px token grid (-${penalty})`)
+    remediations.push("Snap padding, margin, and gap values to the 4px/8px geometric token scale (`--space-1` through `--space-12`).")
+  }
+  if (m.viewportCoverageRatio < 0.15) {
+    spatial -= 6
+    spatialNotes.push(`Sparse viewport coverage (${Math.round(m.viewportCoverageRatio * 100)}%) leaves dead voids (-6)`)
+    remediations.push("Distribute visual weight or scale hero/container proportions to eliminate dead viewport voids.")
+  } else if (m.viewportCoverageRatio > 0.92) {
+    spatial -= 4
+    spatialNotes.push(`Over-crowded viewport coverage (${Math.round(m.viewportCoverageRatio * 100)}%) lacks macro-whitespace (-4)`)
+    remediations.push("Increase macro-whitespace between top-level sections so cards and controls can breathe.")
+  }
+  axes.push({ axis: "Spatial Rhythm & Whitespace", score: Math.max(0, spatial), maxScore: 20, notes: spatialNotes })
+
+  // Axis 2: Typographic Hierarchy & Readability (20 pts)
+  let typo = 20
+  const typoNotes: string[] = []
+  if (m.headingToBodyRatio < 1.25) {
+    typo -= 6
+    typoNotes.push(`Weak heading-to-body scale ratio (${m.headingToBodyRatio}x < 1.25x) (-6)`)
+    remediations.push("Increase typographic scale contrast between primary headings and body copy (>= 1.25x).")
+  }
+  if (m.distinctFontSizes > 7) {
+    typo -= 4
+    typoNotes.push(`Too many distinct font sizes (${m.distinctFontSizes} > 7) creates visual noise (-4)`)
+    remediations.push("Consolidate font sizes to a disciplined 4–6 step modular type scale.")
+  }
+  if (m.descenderClipCount > 0) {
+    const p = Math.min(8, m.descenderClipCount * 4)
+    typo -= p
+    typoNotes.push(`${m.descenderClipCount} element(s) risk clipping descenders (line-height < 1.15 with overflow:hidden) (-${p})`)
+    remediations.push("Raise line-height to >= 1.15 on headings and >= 1.4 on body text inside overflow-clipped containers.")
+  }
+  if (m.proseLineLengthViolations > 0) {
+    const p = Math.min(4, m.proseLineLengthViolations * 2)
+    typo -= p
+    typoNotes.push(`${m.proseLineLengthViolations} paragraph(s) exceed comfortable 75ch reading measure (-${p})`)
+    remediations.push("Constrain long-form body paragraphs to `max-width: 65ch`.")
+  }
+  axes.push({ axis: "Typographic Hierarchy & Readability", score: Math.max(0, typo), maxScore: 20, notes: typoNotes })
+
+  // Axis 3: Color Harmony & WCAG Contrast (20 pts)
+  let color = 20
+  const colorNotes: string[] = []
+  if (m.lowContrastCount > 0) {
+    const p = Math.min(14, m.lowContrastCount * 4)
+    color -= p
+    colorNotes.push(`${m.lowContrastCount} text node(s) fail WCAG AA contrast (-${p})`)
+    remediations.push("Fix low-contrast text nodes so body copy meets >= 4.5:1 and large headings meet >= 3.0:1.")
+  }
+  if (m.neonSlopGradientCount > 0) {
+    const p = Math.min(8, m.neonSlopGradientCount * 4)
+    color -= p
+    colorNotes.push(`${m.neonSlopGradientCount} banned neon purple/magenta AI-slop gradient(s) detected (-${p})`)
+    remediations.push("Replace generic neon purple/pink gradients with intentional surface luminance tokens (`--surface-0..2`).")
+  }
+  axes.push({ axis: "Color Harmony & WCAG Contrast", score: Math.max(0, color), maxScore: 20, notes: colorNotes })
+
+  // Axis 4: Alignment & Grid Cohesion (15 pts)
+  let align = 15
+  const alignNotes: string[] = []
+  if (m.baselineJitterCount > 0) {
+    const p = Math.min(15, m.baselineJitterCount * 3)
+    align -= p
+    alignNotes.push(`${m.baselineJitterCount} sibling row baseline jitter(s) of 0.5px–3.5px (-${p})`)
+    remediations.push("Align sibling cards and row controls using `align-items: center` or uniform top/bottom padding.")
+  }
+  axes.push({ axis: "Alignment & Grid Cohesion", score: Math.max(0, align), maxScore: 15, notes: alignNotes })
+
+  // Axis 5: Interactive Affordance & Accessibility (15 pts)
+  let inter = 15
+  const interNotes: string[] = []
+  if (m.tinyTargetCount > 0) {
+    const p = Math.min(10, m.tinyTargetCount * 3)
+    inter -= p
+    interNotes.push(`${m.tinyTargetCount} interactive control(s) smaller than 24x24px (-${p})`)
+    remediations.push("Enlarge interactive buttons and inputs to at least 28x28px on desktop and 40x40px on mobile.")
+  }
+  if (m.unlabeledControlCount > 0) {
+    const p = Math.min(8, m.unlabeledControlCount * 4)
+    inter -= p
+    interNotes.push(`${m.unlabeledControlCount} interactive control(s) lack visible text or aria-label (-${p})`)
+    remediations.push("Add explicit `aria-label` or visible label text to every interactive button and input.")
+  }
+  axes.push({ axis: "Interactive Affordance & A11y", score: Math.max(0, inter), maxScore: 15, notes: interNotes })
+
+  // Axis 6: Zero-Defect Geometry (10 pts)
+  let geom = 10
+  const geomNotes: string[] = []
+  if (m.horizontalOverflowPx > 0) {
+    geom -= 5
+    geomNotes.push(`Page horizontal overflow of ${m.horizontalOverflowPx}px (-5)`)
+    remediations.push("Eliminate unintended page-level horizontal scroll (`scrollWidth > innerWidth`).")
+  }
+  if (m.elementOverflowCount > 0) {
+    const p = Math.min(5, m.elementOverflowCount * 2)
+    geom -= p
+    geomNotes.push(`${m.elementOverflowCount} overflowing child container(s) (-${p})`)
+    remediations.push("Fix overflowing child containers with `min-width: 0`, `flex-wrap`, or explicit scroll containers.")
+  }
+  if (m.siblingCollisionCount > 0) {
+    const p = Math.min(6, m.siblingCollisionCount * 3)
+    geom -= p
+    geomNotes.push(`${m.siblingCollisionCount} colliding sibling bounding box(es) (-${p})`)
+    remediations.push("Resolve overlapping sibling elements by fixing flex/grid gaps or positioning.")
+  }
+  axes.push({ axis: "Zero-Defect Geometry", score: Math.max(0, geom), maxScore: 10, notes: geomNotes })
+
+  const total = axes.reduce((acc, a) => acc + a.score, 0)
+  const grade: UXScorecard["grade"] =
+    total >= 95 ? "S" : total >= 85 ? "A" : total >= 75 ? "B" : total >= 60 ? "C" : "F"
+
+  return {
+    score: total,
+    grade,
+    passed: total >= threshold,
+    threshold,
+    axes,
+    remediations,
+    evaluatedAt: new Date().toISOString(),
+  }
+}
+
+export async function saveUXScorecard(rootDir: string, scorecard: UXScorecard): Promise<string> {
+  const dir = path.join(rootDir, ".opencode", "artifacts")
+  await fs.mkdir(dir, { recursive: true })
+  const file = path.join(dir, "ux-scorecard.json")
+  await fs.writeFile(file, JSON.stringify(scorecard, null, 2), "utf8")
+  return file
+}
+
+export async function loadLatestUXScorecard(rootDir: string): Promise<UXScorecard | null> {
+  try {
+    const raw = await fs.readFile(path.join(rootDir, ".opencode", "artifacts", "ux-scorecard.json"), "utf8")
+    return JSON.parse(raw) as UXScorecard
+  } catch {
+    return null
+  }
+}
+
+export function registerUXJudgeTools(editor: any, rootDir: string): void {
+  editor.add({
+    name: "get_ux_Required_script",
+    description:
+      "Return the JavaScript expression string to pass to `tools.browser.evaluate({ tabID, script })` to collect raw 6-axis UI/UX metrics for `tools.ui.score_ux`.",
+    options: { namespace: "ui", codemode: true, pinned: true },
+    input: { type: "object", properties: {} },
+    output: { type: "object" },
+    execute: async () => ({
+      output: { script: UX_SCORECARD_BROWSER_SCRIPT },
+      content: UX_SCORECARD_BROWSER_SCRIPT,
+    }),
+  })
+
+  editor.add({
+    name: "score_ux",
+    description:
+      "Compute a deterministic 0–100 Visual Quality & UI/UX Scorecard (`grade: S|A|B|C|F`, `passed: score >= 85`) from raw browser metrics returned by `get_ux_Required_script`, and save it to `.opencode/artifacts/ux-scorecard.json`.",
+    options: { namespace: "ui", codemode: true, pinned: true },
+    input: {
+      type: "object",
+      properties: {
+        metrics: { type: "object", description: "Raw metrics object returned by evaluating get_ux_Required_script" },
+        threshold: { type: "number", description: "Minimum passing score (default 85)" },
+      },
+      required: ["metrics"],
+    },
+    output: { type: "object" },
+    execute: async (input: { metrics: UXRawMetrics; threshold?: number }) => {
+      const card = scoreUXMetrics(input.metrics, input.threshold ?? 85)
+      await saveUXScorecard(rootDir, card)
+      return {
+        output: card,
+        content: `UX Scorecard: ${card.score}/100 (Grade ${card.grade}) — ${card.passed ? "PASSED" : "FAILED (< " + card.threshold + ")"}\n${card.remediations.map((r) => "- " + r).join("\n")}`,
+      }
+    },
+  })
+}
