{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "typeRoots": ["./node_modules/@types", "./dispatcher/web/node_modules/@types"],
    "types": ["bun", "react", "react-dom"]
  },
  "include": [
    "dispatcher/**/*.ts",
    "dispatcher/**/*.tsx",
    "verifier/**/*.ts",
    "verifier/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ],
  "exclude": ["review", "node_modules", "workspace", "state", "fixtures"]
}
