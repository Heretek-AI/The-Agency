{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "dispatcher/**/*.ts",
    "dispatcher/**/*.tsx",
    "verifier/**/*.ts",
    "verifier/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ],
  "exclude": ["review", "node_modules", "workspace", "state", "fixtures"]
}
