# Example environment for The Agency. Copy to .env and fill in values.
# Empty values refuse to start the service that reads them (fail-closed).

# Model every expert uses (one model for the whole fleet).
AGENCY_MODEL=
# Provider key for the model (lives in .env.provider, never tracked).
OPENCODE_API_KEY=
# Per-expert OpenCode server passwords (one per expert, all unique).
PW_DIRECTOR=
# Per-expert egress proxy passwords.
PROXY_PW_DIRECTOR=
# Bearer token for the Dispatcher's fleet MCP endpoint.
FLEET_MCP_TOKEN=
# Token the verifier requires on its endpoint.
VERIFIER_TOKEN=
# Admin password for the dashboard and REST API.
AGENCY_ADMIN_PASSWORD=
# Host port published by the gateway on 127.0.0.1 only.
AGENCY_HTTP_PORT=8081
# UID/GID the agent user runs as inside expert images.
AGENT_UID=
AGENT_GID=
# Pinned OpenCode and Bun versions (must match versions.env).
OPENCODE_VERSION=
BUN_VERSION=
# Stage 0 only: read-only path to the frozen heretek-opencode checkout.
SALVAGE_SRC=
