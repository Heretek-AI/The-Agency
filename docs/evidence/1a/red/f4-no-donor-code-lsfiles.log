$ command -v git
/usr/bin/git
$ cat /tmp/opencode/f4-shim/git    # shim, never committed
#!/usr/bin/env bash
if [ "${1:-}" = "ls-files" ]; then
  echo "shim: git ls-files unavailable" >&2
  exit 128
fi
exec /usr/bin/git "$@"
$ chmod +x /tmp/opencode/f4-shim/git

